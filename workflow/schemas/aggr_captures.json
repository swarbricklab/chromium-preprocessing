{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "capture": { 
        "type": "string",
        "description": "Capture identifier"
      },
      "pool": { 
        "type": "string",
        "description": "Pool identifier. Two or more captures from same pool will be aggregated if assigned the same pool identifier"
      }
    },
    "required": ["capture", "pool"]
  }
